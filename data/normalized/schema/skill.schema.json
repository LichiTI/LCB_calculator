{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "NormalizedSkill (uptie IV)",
  "type": "object",
  "required": ["id", "file", "skillTier", "owners", "discoveredVia", "levelsAvailable", "levelsMerged",
               "fieldSourceLevel", "basePower", "coinCount", "attrs", "abilityScripts", "coins"],
  "properties": {
    "id": {"type": "integer"},
    "skillTier": {"type": "integer"},
    "levelsMerged": {"type": "array", "minItems": 1, "items": {"type": "integer", "maximum": 4}},
    "basePower": {"type": "integer"},
    "coinCount": {"type": "integer", "minimum": 0},
    "attrs": {"type": "object", "required": ["attributeType", "atkType", "defType", "skillLevelCorrection"]},
    "abilityScripts": {"type": "array", "items": {"$ref": "#/$defs/script"}},
    "coins": {"type": "array", "items": {
      "type": "object", "required": ["index", "operatorType", "scale"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "operatorType": {"type": "string"},
        "scale": {"type": "number"},
        "abilityScriptList": {"type": "array", "items": {"$ref": "#/$defs/script"}}}}}
  },
  "$defs": {
    "script": {"type": "object", "required": ["scriptName"],
               "properties": {"scriptName": {"type": "string", "minLength": 1}}}
  }
}
